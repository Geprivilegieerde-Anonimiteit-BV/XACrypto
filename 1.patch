+    static int passed = 0;
+    static int failed = 0;
+
+    static void check(String name, boolean ok) {
+        if (ok) { passed++; System.out.println("  PASS: " + name); }
+        else    { failed++; System.out.println("  FAIL: " + name); }
+    }
+
+    static void runTests() {
+        System.out.println("=== XACrypto Smoke Tests ===\n");
+
+        testDigestPadding();
+        testMerkleTree();
+        testIsNull();
+        testROTL32();
+        testAesEcbPadding();
+        testCamelliaEcbPadding();
+        testRc6EcbPadding();
+        testTwofishEcbPadding();
+
+        System.out.println("\n=== Results: " + passed + " passed, " + failed + " failed ===");
+        if (failed > 0) System.exit(1);
+    }
+
+    static void testDigestPadding() {
+        System.out.println("[#22] SHA-256 Digest padding edge case (55 mod 64):");
+        try {
+            byte[] input55 = new byte[55];
+            Digest d1 = new Digest();
+            byte[] h1 = d1.upd(input55).digest();
+            check("55-byte input produces valid hash", h1.length == 32);
+
+            byte[] input119 = new byte[119];
+            Digest d2 = new Digest();
+            byte[] h2 = d2.upd(input119).digest();
+            check("119-byte input produces valid hash", h2.length == 32);
+
+            byte[] input0 = new byte[0];
+            Digest d3 = new Digest();
+            byte[] h3 = d3.upd(input0).digest();
+            check("0-byte input produces valid hash", h3.length == 32);
+
+            byte[] input63 = new byte[63];
+            Digest d4 = new Digest();
+            byte[] h4 = d4.upd(input63).digest();
+            check("63-byte input produces valid hash", h4.length == 32);
+
+            byte[] input64 = new byte[64];
+            Digest d5 = new Digest();
+            byte[] h5 = d5.upd(input64).digest();
+            check("64-byte input produces valid hash", h5.length == 32);
+        } catch (Exception e) {
+            check("Digest padding threw: " + e.getMessage(), false);
+        }
+    }
+
+    static void testMerkleTree() {
+        System.out.println("\n[#23] SHA-256 Merkle tree (mergeUp termination):");
+        try {
+            List<byte[]> leaves = new ArrayList<>();
+            for (int i = 0; i < 8; i++) leaves.add(("leaf" + i).getBytes());
+            byte[] root = SHA256.merkRoot(leaves);
+            check("merkRoot() completed, root length=32", root.length == 32);
+        } catch (Exception e) {
+            check("merkRoot() threw: " + e.getMessage(), false);
+        }
+
+        System.out.println("\n[#32] merkRootDuo (double-hash leaves):");
+        try {
+            List<byte[]> leaves = new ArrayList<>();
+            for (int i = 0; i < 4; i++) leaves.add(("duo" + i).getBytes());
+            byte[] root = SHA256.merkRootDuo(leaves);
+            check("merkRootDuo() completed, root length=32", root.length == 32);
+        } catch (Exception e) {
+            check("merkRootDuo() threw: " + e.getMessage(), false);
+        }
+    }
+
+    static void testIsNull() {
+        System.out.println("\n[#33] isNull.isValidText null safety:");
+        check("isValidText(null) returns false", !isNull.isValidText(null));
+        check("isValidText(\"\") returns false", !isNull.isValidText(""));
+        check("isValidText(\"  \") returns false", !isNull.isValidText("  "));
+        check("isValidText(\"hello\") returns true", isNull.isValidText("hello"));
+    }
+
+    static void testROTL32() {
+        System.out.println("\n[#24] ROT.ROTL32 operator precedence:");
+        long v = 0x00000001_FFFFFFFFL;
+        long r = ROT.ROTL32(v, 4);
+        check("ROTL32 truncates to 32 bits", (r >>> 32) == 0);
+        check("ROTL32(1, 1) == 2", ROT.ROTL32(1L, 1) == 2L);
+    }
+
+    static void testAesEcbPadding() {
+        System.out.println("\n[#30] AES ECB padding validation:");
+        try {
+            byte[] key = new byte[16];
+            AESECB aes = new AESECB(key);
+            byte[] badCip = new byte[32];
+            badCip[31] = 0x00;
+            aes.decrypt(badCip);
+            check("rejects bad padding (pLen=0)", false);
+        } catch (XACryptoException e) {
+            check("rejects bad padding (pLen=0)", true);
+        } catch (Exception e) {
+            check("rejects bad padding (pLen=0)", true);
+        }
+    }
+
+    static void testCamelliaEcbPadding() {
+        System.out.println("\n[#30] Camellia ECB padding validation:");
+        try {
+            byte[] key = new byte[16];
+            CamelliaECB cam = new CamelliaECB(key);
+            byte[] badCip = new byte[32];
+            badCip[31] = (byte) 0xFF;
+            cam.decrypt(badCip);
+            check("rejects bad padding", false);
+        } catch (XACryptoException e) {
+            check("rejects bad padding", true);
+        } catch (Exception e) {
+            check("rejects bad padding", true);
+        }
+    }
+
+    static void testRc6EcbPadding() {
+        System.out.println("\n[#30] RC6 ECB padding validation:");
+        try {
+            byte[] key = new byte[16];
+            RC6ECB rc6 = new RC6ECB(key);
+            byte[] badCip = new byte[32];
+            badCip[31] = 0x00;
+            rc6.decrypt(badCip);
+            check("rejects bad padding", false);
+        } catch (XACryptoException e) {
+            check("rejects bad padding", true);
+        } catch (Exception e) {
+            check("rejects bad padding", true);
+        }
+    }
+
+    static void testTwofishEcbPadding() {
+        System.out.println("\n[#30] Twofish ECB roundtrip + padding validation:");
+        try {
+            byte[] key = new byte[16];
+            TwofishECB tf = new TwofishECB(key);
+            byte[] enc = tf.encrypt("twofish".getBytes());
+            byte[] dec = tf.decrypt(enc);
+            check("roundtrip", new String(dec).equals("twofish"));
+        } catch (Exception e) {
+            check("roundtrip threw: " + e.getMessage(), false);
+        }
+
+        try {
+            byte[] key = new byte[16];
+            TwofishECB tf = new TwofishECB(key);
+            byte[] badCip = new byte[32];
+            badCip[31] = (byte) 0x10;
+            tf.decrypt(badCip);
+            check("rejects bad padding (pLen=16)", false);
+        } catch (XACryptoException e) {
+            check("rejects bad padding (pLen=16)", true);
+        } catch (Exception e) {
+            check("rejects bad padding (pLen=16)", true);
+        }
+    }
 }
